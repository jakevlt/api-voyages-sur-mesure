@startuml
skinparam defaultFontName DejaVu Sans
skinparam dpi 130
skinparam shadowing false
skinparam sequenceMessageAlign center
title Séquence — simulation rapide anonyme puis rattachement avec le code de reprise (API-06, API-07 ★)

actor "Visiteur\n(puis membre)" as V
participant "Application cliente" as C
participant "API Symfony" as API
participant "Limiteur de débit" as RL
database "MariaDB" as DB

== 1. Simulation rapide sans compte (API-06) ==
V -> C : destination, budget, durée,\ncoordonnées facultatives + consentement
C -> API : POST /api/simulations-rapides
API -> RL : consommer un envoi (adresse IP)
alt trop d'envois depuis cette IP
  API --> C : 429
else
  API -> API : valider (bornes budget/durée, destination existante,\nconsentement obligatoire si coordonnées)
  alt données invalides
    API --> C : 422 {"erreurs": [...]}
  else
    API -> API : code = random_bytes(16) (secret)\nempreinte = password_hash(code)
    API -> DB : INSERT simulation_rapide (..., Code_reprise_hash)
    API --> C : 201 {"id": 42, "codeReprise": "k3F9...", ...}
    note right : le code en clair n'est renvoyé\nqu'une seule fois et jamais stocké
  end
end

== 2. Le visiteur crée un compte puis se connecte (API-02, API-01) ==
C -> API : POST /api/auth/connexion
API --> C : 200 {"token": "eyJ..."}

== 3. Rattachement (API-07 ★) ==
C -> API : POST /api/simulations/rattacher\nBearer eyJ... {"id": 42, "codeReprise": "k3F9..."}
API -> DB : SELECT simulation_rapide WHERE IdSimulationRapide = 42
alt simulation inconnue, déjà rattachée,\nou code faux (password_verify = faux)
  API --> C : 404 {"erreur": "Simulation introuvable"}
  note right : même réponse dans tous les cas :\nconnaître le numéro ne suffit pas
else code correct et pas encore utilisé
  API -> DB : UPDATE simulation_rapide SET IdUser = membre,\nDate_rattachement = NOW()
  API --> C : 200 {"id": 42, "rattacheeA": "membre"}
  note right : le code ne peut plus resservir\n(Date_rattachement renseignée)
end
@enduml
