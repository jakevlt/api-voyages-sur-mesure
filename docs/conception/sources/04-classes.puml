@startuml
skinparam defaultFontName DejaVu Sans
skinparam dpi 130
skinparam shadowing false
skinparam class {
  BackgroundColor #ffffff
  BorderColor #333333
}
hide empty methods
title Diagramme de classes — entités Doctrine de l'API

enum Role {
  USER
  ADMIN_gerante
}
enum StatutSimulation {
  BROUILLON
  EN_ATTENTE (envoyée)
  EN_DISCUSSION
  DEVIS_ENVOYE
  CLOTUREE
  VALIDE / REFUSE (site)
  --
  +transitionsPossibles() : StatutSimulation[]
}

class Utilisateur {
  -id : int
  -login : string
  -password : string
  -nom : string
  -contact : ?string
  -telephone : ?string
  -role : Role
  -dateInscription : Date
  -actif : bool
  -nbEchecsConnexion : int
  -dateDernierEchec : ?DateTime
  -consentementRappel : bool
  -dateConsentement : ?DateTime
  --
  +getRoles() : string[]
  +estBloque() : bool
  +enregistrerEchec() : void
  +reinitialiserEchecs() : void
}

class Simulation {
  -id : int
  -dateSoumission : Date
  -budget : ?float
  -dateDepart : ?Date
  -dateRetour : ?Date
  -villeDepart : ?string
  -villeArrivee : ?string
  -besoinSpecifique : ?string
  -attentes : ?string
  -animaux : ?string
  -flexibiliteJours : ?int
  -statut : StatutSimulation
  -dateEnvoi : ?Date
  --
  +estModifiable() : bool
  +envoyer() : void
  +changerStatut(nouveau, auteur) : HistoriqueStatut
}

class SimulationRapide {
  -id : int
  -budget : float
  -duree : int
  -nom : ?string
  -email : ?string
  -telephone : ?string
  -consentementRappel : bool
  -dateConsentement : ?DateTime
  -codeRepriseHash : string
  -dateCreation : DateTime
  -dateRattachement : ?DateTime
  --
  +verifierCode(code) : bool
  +rattacher(membre) : void
}

class HistoriqueStatut {
  -id : int
  -ancienStatut : string
  -nouveauStatut : string
  -dateChangement : DateTime
}

class DestinationChoisie <<inclu_destination>> {
  -priorite : int
}
class CompositionGroupe <<inclu_voyageur>> {
  -nbreVoyageur : int
}

class Destination {
  -id : int
  -ville : string
  -region : ?string
}
class Theme {
  -id : int
  -libelle : string
}
class TypeActivite {
  -id : int
  -libelle : string
}
class Logement {
  -id : int
  -libelle : string
}
class Transport {
  -id : int
  -libelle : string
}
class TypeSejour {
  -id : int
  -libelle : string
}
class TypeVoyageur {
  -id : int
  -libelle : string
}

Utilisateur "0..1" -- "0..*" Simulation : soumet >
Utilisateur "0..1" -- "0..*" SimulationRapide : rattache >
Utilisateur "1" -- "0..*" HistoriqueStatut : effectue >
Simulation "1" *-- "0..*" HistoriqueStatut : trace >
Simulation "*" --> "1" Destination : principale
Simulation "1" *-- "0..*" DestinationChoisie
DestinationChoisie "*" --> "1" Destination
Simulation "*" --> "1" Theme : principal
Simulation "*" --> "0..*" Theme : thèmes complémentaires
Simulation "*" --> "0..*" TypeActivite
Simulation "*" --> "1" Logement
Simulation "*" --> "1" Transport
Simulation "*" --> "0..1" TypeSejour
Simulation "1" *-- "0..*" CompositionGroupe
CompositionGroupe "*" --> "1" TypeVoyageur
SimulationRapide "*" --> "1" Destination
Utilisateur ..> Role
Simulation ..> StatutSimulation
@enduml
