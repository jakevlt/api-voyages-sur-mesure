graph MCD {
  graph [fontname="DejaVu Sans", rankdir=LR, nodesep=0.35, ranksep=0.65, label="MCD — base du site Voyage POC (version du 19/11/2026)", labelloc=t, fontsize=15, pad=0.25];
  node [fontname="DejaVu Sans", fontsize=10, shape=plain];
  edge [fontname="DejaVu Sans", fontsize=10];
  UTILISATEUR [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e8eef7"><b>UTILISATEUR</b></td></tr><tr><td align="left"><u>IdUser</u><br align="left"/>Nom<br align="left"/>Prenom<br align="left"/>Login<br align="left"/>Password<br align="left"/>Contact<br align="left"/>Telephone<br align="left"/>Role<br align="left"/>Admin_principal<br align="left"/>Date_inscription<br align="left"/>Date_suppression<br align="left"/></td></tr></table>>];
  SIMULATION [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e8eef7"><b>SIMULATION</b></td></tr><tr><td align="left"><u>IdSimulation</u><br align="left"/>Date_soumission<br align="left"/>Budget<br align="left"/>Date_Depart<br align="left"/>Date_Retour<br align="left"/>Ville_Depart<br align="left"/>Ville_Retour<br align="left"/>Besoin_Specifique<br align="left"/>Attentes<br align="left"/>Animaux<br align="left"/>Statut<br align="left"/>Date_Envoie<br align="left"/></td></tr></table>>];
  DESTINATION [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e8eef7"><b>DESTINATION</b></td></tr><tr><td align="left"><u>IdDestination</u><br align="left"/>Ville<br align="left"/>Region<br align="left"/></td></tr></table>>];
  THEME [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e8eef7"><b>THEME</b></td></tr><tr><td align="left"><u>IdTheme</u><br align="left"/>Theme<br align="left"/></td></tr></table>>];
  LOGEMENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e8eef7"><b>LOGEMENT</b></td></tr><tr><td align="left"><u>IdLogement</u><br align="left"/>Type_Logement<br align="left"/></td></tr></table>>];
  TRANSPORT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e8eef7"><b>TRANSPORT</b></td></tr><tr><td align="left"><u>IdTransport</u><br align="left"/>Type_Transport<br align="left"/></td></tr></table>>];
  TYPE_SEJOUR [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e8eef7"><b>TYPE_SEJOUR</b></td></tr><tr><td align="left"><u>IdTypeSejour</u><br align="left"/>Type_Sejour<br align="left"/></td></tr></table>>];
  TYPE_ACTIVITE [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e8eef7"><b>TYPE_ACTIVITE</b></td></tr><tr><td align="left"><u>IdType</u><br align="left"/>Type<br align="left"/></td></tr></table>>];
  VOYAGEUR [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e8eef7"><b>VOYAGEUR</b></td></tr><tr><td align="left"><u>IdVoyageur</u><br align="left"/>Type_Voyageur<br align="left"/></td></tr></table>>];
  SIMULATION_RAPIDE [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e8eef7"><b>SIMULATION_RAPIDE</b></td></tr><tr><td align="left"><u>IdSimulationRapide</u><br align="left"/>Budget<br align="left"/>Duree<br align="left"/>Email<br align="left"/>Telephone<br align="left"/>Consentement_rappel<br align="left"/>Date_consentement<br align="left"/>Code_reprise_hash<br align="left"/>Date_creation<br align="left"/></td></tr></table>>];
  JOURNAL_ADMIN [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e8eef7"><b>JOURNAL_ADMIN</b></td></tr><tr><td align="left"><u>IdJournal</u><br align="left"/>Admin_nom<br align="left"/>Action<br align="left"/>Cible<br align="left"/>Cible_type<br align="left"/>Cible_id<br align="left"/>Date_action<br align="left"/></td></tr></table>>];
  node [shape=ellipse, style=filled, fillcolor="#f2f2f2"];
  effectue [label="effectue"]; concerne [label="concerne"]; rythme [label="a pour rythme"]; heberge [label="est hébergée en"];
  deplace [label="se déplace par"]; etre [label="est de type"]; inclut [label="inclut"];
  compose [label="compose\n(nbre_voyageur)"]; porte [label="porte sur"]; realise [label="réalise"]; recupere [label="récupère"];
  UTILISATEUR -- effectue [label="0,n"]; effectue -- SIMULATION [label="0,1"];
  SIMULATION -- concerne [label="1,1"]; concerne -- DESTINATION [label="0,n"];
  SIMULATION -- rythme [label="1,1"]; rythme -- THEME [label="0,n"];
  SIMULATION -- heberge [label="1,1"]; heberge -- LOGEMENT [label="0,n"];
  SIMULATION -- deplace [label="1,1"]; deplace -- TRANSPORT [label="0,n"];
  SIMULATION -- etre [label="1,1"]; etre -- TYPE_SEJOUR [label="0,n"];
  SIMULATION -- inclut [label="0,n"]; inclut -- TYPE_ACTIVITE [label="0,n"];
  SIMULATION -- compose [label="1,n"]; compose -- VOYAGEUR [label="0,n"];
  SIMULATION_RAPIDE -- porte [label="1,1"]; porte -- DESTINATION [label="0,n"];
  UTILISATEUR -- recupere [label="0,n"]; recupere -- SIMULATION_RAPIDE [label="0,1"];
  UTILISATEUR -- realise [label="0,n"]; realise -- JOURNAL_ADMIN [label="0,1"];
}
