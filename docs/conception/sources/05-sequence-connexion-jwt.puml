@startuml
skinparam defaultFontName DejaVu Sans
skinparam dpi 130
skinparam shadowing false
skinparam sequenceMessageAlign center
title Séquence — connexion avec jeton JWT (API-01) puis appel d'une route protégée

actor "Membre" as M
participant "Application cliente\n(tests / future appli mobile)" as C
participant "API Symfony\n(firewall + JSON login)" as API
participant "Limiteur de débit\n(RateLimiter)" as RL
participant "Fournisseur\nd'utilisateurs" as UP
database "MariaDB\nagence_voyage" as DB
participant "Hacheur de mots\nde passe (bcrypt)" as H
participant "Gestionnaire JWT\n(lexik)" as JWT

M -> C : saisit login + mot de passe
C -> API : POST /api/auth/connexion\n{"login": "...", "password": "..."} (HTTPS)
API -> RL : consommer un essai (login + IP)
alt plus de 5 échecs récents
  RL --> API : refusé
  API --> C : 429 Too Many Requests
else essai autorisé
  API -> UP : charger l'utilisateur par login
  UP -> DB : SELECT ... FROM utilisateur WHERE Login = ? (requête préparée)
  DB --> UP : utilisateur (ou rien)
  alt utilisateur inconnu, mot de passe faux ou compte désactivé
    API -> H : vérifier le mot de passe
    API -> DB : Nb_echecs_connexion + 1, Date_dernier_echec
    API --> C : 401 {"erreur": "Identifiants invalides"}\n(même message dans tous les cas)
  else identifiants corrects et compte actif
    API -> H : verify(password, empreinte $2y$...)
    H --> API : OK
    API -> DB : Nb_echecs_connexion = 0
    API -> JWT : créer un jeton (id, rôle, expiration 30 min)
    JWT --> API : jeton signé (clé hors du dépôt)
    API --> C : 200 {"token": "eyJ..."}
  end
end

== Plus tard : appel d'une route protégée ==
C -> API : GET /api/simulations\nAuthorization: Bearer eyJ...
API -> JWT : vérifier signature + expiration
alt jeton absent, modifié ou expiré
  API --> C : 401
else jeton valide
  API -> DB : simulations WHERE IdUser = (utilisateur du jeton)
  API --> C : 200 [liste paginée de MES simulations]
end
@enduml
